            </entry>
          </resourceIds>
          <queueBufferSize>1000</queueBufferSize>
          <reattachAttachments>true</reattachAttachments>
        </destinationConnectorProperties>
        <script><![CDATA[
// POSTs the patient demographics payload to LCIIS. 409 (already exists) is
// expected on re-admission/duplicate ADT messages and is treated as success.

importPackage(java.net);
importPackage(java.io);

var apiBaseUrl = configurationMap.get('LCIIS_API_URL');
if (!apiBaseUrl) { apiBaseUrl = 'http://localhost:8000'; }

var payload = channelMap.get('patientPayload');
var url = new URL(apiBaseUrl + '/api/patients');
var conn = url.openConnection();
conn.setRequestMethod('POST');
conn.setDoOutput(true);
conn.setRequestProperty('Content-Type', 'application/json');
conn.setConnectTimeout(10000);
conn.setReadTimeout(10000);

var out = conn.getOutputStream();
out.write(java.lang.String(payload).getBytes('UTF-8'));
out.flush();
out.close();

var status = conn.getResponseCode();
if (status >= 400 && status != 409) {
    var stream = conn.getErrorStream();
    var errText = '';
    if (stream != null) {
        var scanner = new java.util.Scanner(stream, 'UTF-8').useDelimiter('\\A');
        errText = scanner.hasNext() ? scanner.next() : '';
    }
    throw 'LCIIS API returned HTTP ' + status + ': ' + errText;
}
conn.disconnect();

return 'Patient sync HTTP ' + status;
]]></script>
