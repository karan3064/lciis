        <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
          <name>Parse ADT^A01 and build patient payload</name>
          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script><![CDATA[
var patientId = msg['PID']['PID.3']['PID.3.1'].toString();
var lastName = msg['PID']['PID.5']['PID.5.1'].toString();
var firstName = msg['PID']['PID.5']['PID.5.2'].toString();
var patientName = (firstName + ' ' + lastName).trim() || patientId;

var dobRaw = msg['PID']['PID.7']['PID.7.1'].toString();
var dob = null;
if (dobRaw && dobRaw.length >= 8) {
    dob = dobRaw.substring(0, 4) + '-' + dobRaw.substring(4, 6) + '-' + dobRaw.substring(6, 8);
}
var sex = msg['PID']['PID.8']['PID.8.1'].toString() || null;

var ward = msg['PV1']['PV1.3']['PV1.3.1'].toString();
var bed = msg['PV1']['PV1.3']['PV1.3.2'].toString();

var payload = {
    id: patientId,
    name: patientName,
    date_of_birth: dob,
    sex: sex,
    bed: bed || null,
    ward: ward || null
};

channelMap.put('patientPayload', JSON.stringify(payload));
]]></script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
